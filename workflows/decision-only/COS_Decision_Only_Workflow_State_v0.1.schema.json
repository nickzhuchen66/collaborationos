{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nickzhuchen66/collaborationos/workflows/decision-only/COS_Decision_Only_Workflow_State_v0.1.schema.json",
  "title": "COS WF02 Decision-Only Public Toolkit State v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "workflow_id",
    "workflow_run_id",
    "observed_at",
    "as_of",
    "mode",
    "artifacts",
    "stages",
    "outcome",
    "terminal_state",
    "decision_disposition",
    "record_accepted",
    "eligible_for_p05_evaluation_observed",
    "p05_started",
    "execution_authorized",
    "host_access",
    "external_calls",
    "incremental_external_cost_usd",
    "automatic_retry",
    "issues",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {"const": "0.1-public"},
    "workflow_id": {"const": "COS-WF02"},
    "workflow_run_id": {"type": "string", "minLength": 3},
    "observed_at": {"type": "string", "format": "date-time"},
    "as_of": {"type": "string", "format": "date-time"},
    "mode": {"const": "manual_static_decision_only"},
    "artifacts": {"type": "object"},
    "stages": {"type": "array", "minItems": 5, "maxItems": 5},
    "outcome": {"enum": ["success", "failed"]},
    "terminal_state": {"enum": ["decision_recorded_no_execution", "failed_closed"]},
    "decision_disposition": {"type": "string", "minLength": 1},
    "record_accepted": {"type": "boolean"},
    "eligible_for_p05_evaluation_observed": {"type": "boolean"},
    "p05_started": {"const": false},
    "execution_authorized": {"const": false},
    "host_access": {"const": false},
    "external_calls": {"const": 0},
    "incremental_external_cost_usd": {"const": 0},
    "automatic_retry": {"const": false},
    "issues": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "authority_effect": {"const": "none"}
  }
}
