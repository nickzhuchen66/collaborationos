{
  "$defs": {
    "acceptance_event": {
      "additionalProperties": false,
      "properties": {
        "acceptance_event_id": {
          "$ref": "#/$defs/acceptance_event_id"
        },
        "accepted_a03_artifact_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "accepted_a03_artifact_id": {
          "$ref": "#/$defs/stable_id"
        },
        "accepted_a03_binding_id": {
          "$ref": "#/$defs/stable_id"
        },
        "accepted_at": {
          "$ref": "#/$defs/timestamp"
        },
        "accepted_by_actor_id": {
          "$ref": "#/$defs/stable_id"
        },
        "artifact_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "artifact_id": {
          "$ref": "#/$defs/artifact_id"
        },
        "assertions": {
          "items": {
            "$ref": "#/$defs/stable_id"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "authority_source_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "authority_source_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "result": {
          "enum": [
            "pass",
            "fail",
            "not_observed",
            "not_attempted"
          ]
        },
        "scope": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "acceptance_event_id",
        "artifact_id",
        "artifact_checksum",
        "accepted_by_actor_id",
        "accepted_a03_artifact_id",
        "accepted_a03_artifact_checksum",
        "accepted_a03_binding_id",
        "authority_source_ref",
        "authority_source_checksum",
        "accepted_at",
        "scope",
        "assertions",
        "result"
      ],
      "type": "object"
    },
    "acceptance_event_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^accept-[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "actor_binding": {
      "additionalProperties": false,
      "properties": {
        "accepted_a03_artifact_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "accepted_a03_artifact_id": {
          "$ref": "#/$defs/stable_id"
        },
        "accepted_a03_binding_id": {
          "$ref": "#/$defs/stable_id"
        },
        "actor_id": {
          "$ref": "#/$defs/stable_id"
        },
        "actor_kind": {
          "enum": [
            "human",
            "ai_agent",
            "deterministic_system",
            "organization_ref"
          ]
        },
        "authority_source_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "authority_source_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "scope": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "actor_id",
        "actor_kind",
        "accepted_a03_artifact_id",
        "accepted_a03_artifact_checksum",
        "accepted_a03_binding_id",
        "authority_source_ref",
        "authority_source_checksum",
        "scope"
      ],
      "type": "object"
    },
    "admission_event": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "event_sequence": {
                "const": 1
              }
            }
          },
          "then": {
            "properties": {
              "prior_admission_disposition": {
                "const": "none"
              },
              "prior_admission_event_id": {
                "const": "none"
              }
            }
          }
        }
      ],
      "properties": {
        "accepted_a03_artifact_checksum": {
          "$ref": "#/$defs/checksum"
        },
        "accepted_a03_artifact_id": {
          "$ref": "#/$defs/stable_id"
        },
        "accepted_a03_binding_id": {
          "$ref": "#/$defs/stable_id"
        },
        "admission_event_id": {
          "$ref": "#/$defs/admission_event_id"
        },
        "event_sequence": {
          "minimum": 1,
          "type": "integer"
        },
        "evidence_item_id": {
          "$ref": "#/$defs/evidence_item_id"
        },
        "prior_admission_disposition": {
          "enum": [
            "none",
            "admitted",
            "admitted_with_limitations",
            "excluded",
            "not_observed"
          ]
        },
        "prior_admission_event_id": {
          "$ref": "#/$defs/none_or_admission_event_id"
        },
        "reason": {
          "minLength": 1,
          "type": "string"
        },
        "result_admission_disposition": {
          "enum": [
            "admitted",
            "admitted_with_limitations",
            "excluded",
            "not_observed"
          ]
        },
        "reviewed_at": {
          "$ref": "#/$defs/timestamp"
        },
        "reviewer_actor_id": {
          "$ref": "#/$defs/stable_id"
        }
      },
      "required": [
        "admission_event_id",
        "evidence_item_id",
        "reviewer_actor_id",
        "accepted_a03_artifact_id",
        "accepted_a03_artifact_checksum",
        "accepted_a03_binding_id",
        "event_sequence",
        "prior_admission_event_id",
        "prior_admission_disposition",
        "result_admission_disposition",
        "reason",
        "reviewed_at"
      ],
      "type": "object"
    },
    "admission_event_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^admission-event-[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "artifact_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^COS-A02-[A-Za-z0-9._-]*$",
      "type": "string"
    },
    "artifact_ref": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/stable_id"
        },
        "artifact_lifecycle": {
          "enum": [
            "draft",
            "under_review",
            "accepted",
            "rejected",
            "superseded"
          ]
        },
        "checksum": {
          "$ref": "#/$defs/checksum"
        },
        "current": {
          "type": "boolean"
        },
        "cutoff": {
          "$ref": "#/$defs/timestamp"
        }
      },
      "required": [
        "artifact_id",
        "checksum",
        "cutoff",
        "artifact_lifecycle",
        "current"
      ],
      "type": "object"
    },
    "checksum": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "claim_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^claim-[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "current_admission": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "decision_basis_eligible": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "admission_disposition": {
                "enum": [
                  "admitted",
                  "admitted_with_limitations"
                ]
              }
            }
          }
        }
      ],
      "properties": {
        "admission_disposition": {
          "enum": [
            "admitted",
            "admitted_with_limitations",
            "excluded",
            "not_observed"
          ]
        },
        "decision_basis_eligible": {
          "type": "boolean"
        },
        "derived_from_event_id": {
          "$ref": "#/$defs/admission_event_id"
        },
        "evidence_item_id": {
          "$ref": "#/$defs/evidence_item_id"
        }
      },
      "required": [
        "evidence_item_id",
        "derived_from_event_id",
        "admission_disposition",
        "decision_basis_eligible"
      ],
      "type": "object"
    },
    "evidence_item": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/claim_id"
        },
        "conflict_state": {
          "enum": [
            "none",
            "resolved",
            "unresolved",
            "not_observed"
          ]
        },
        "evidence_item_id": {
          "$ref": "#/$defs/evidence_item_id"
        },
        "grounding_state": {
          "enum": [
            "grounded",
            "ungrounded",
            "not_observed"
          ]
        },
        "requirement_class": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "safe_statement": {
          "minLength": 1,
          "type": "string"
        },
        "source_checksum": {
          "oneOf": [
            {
              "$ref": "#/$defs/checksum"
            },
            {
              "const": "not_observed"
            }
          ]
        },
        "source_id": {
          "$ref": "#/$defs/stable_id"
        },
        "statement_type": {
          "enum": [
            "observation",
            "measurement",
            "source_report",
            "derived_calculation",
            "expert_judgment"
          ]
        }
      },
      "required": [
        "evidence_item_id",
        "claim_id",
        "statement_type",
        "requirement_class",
        "source_id",
        "source_checksum",
        "safe_statement",
        "conflict_state",
        "grounding_state"
      ],
      "type": "object"
    },
    "evidence_item_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^evidence-[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "failure_envelope": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/stable_id"
        },
        "evidence_refs": {
          "items": {
            "$ref": "#/$defs/safe_ref"
          },
          "type": "array",
          "uniqueItems": true
        },
        "last_safe_checkpoint": {
          "minLength": 1,
          "type": "string"
        },
        "manual_takeover_required": {
          "type": "boolean"
        },
        "owner_role": {
          "$ref": "#/$defs/stable_id"
        },
        "public_message": {
          "minLength": 1,
          "type": "string"
        },
        "retryable": {
          "type": "boolean"
        },
        "side_effect_occurred": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "public_message",
        "retryable",
        "side_effect_occurred",
        "last_safe_checkpoint",
        "manual_takeover_required",
        "owner_role",
        "evidence_refs"
      ],
      "type": "object"
    },
    "interpretation": {
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "claim_id": {
          "$ref": "#/$defs/claim_id"
        },
        "confidence_state": {
          "enum": [
            "high",
            "medium",
            "low",
            "not_observed"
          ]
        },
        "contradicting_evidence_ids": {
          "items": {
            "$ref": "#/$defs/evidence_item_id"
          },
          "type": "array",
          "uniqueItems": true
        },
        "interpretation_id": {
          "$ref": "#/$defs/interpretation_id"
        },
        "limitations": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "limiting_evidence_ids": {
          "items": {
            "$ref": "#/$defs/evidence_item_id"
          },
          "type": "array",
          "uniqueItems": true
        },
        "supporting_evidence_ids": {
          "items": {
            "$ref": "#/$defs/evidence_item_id"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "interpretation_id",
        "claim_id",
        "supporting_evidence_ids",
        "contradicting_evidence_ids",
        "limiting_evidence_ids",
        "assumptions",
        "limitations",
        "confidence_state"
      ],
      "type": "object"
    },
    "interpretation_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^interpretation-[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "none_or_admission_event_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^(?:none|admission-event-[A-Za-z0-9._-]+)$",
      "type": "string"
    },
    "none_or_checksum": {
      "pattern": "^(?:none|[a-f0-9]{64})$",
      "type": "string"
    },
    "none_or_id": {
      "pattern": "^(?:none|[A-Za-z0-9][A-Za-z0-9._:-]{2,127})$",
      "type": "string"
    },
    "protocol_run": {
      "additionalProperties": false,
      "properties": {
        "downstream_started": {
          "const": false
        },
        "failure_envelope": {
          "oneOf": [
            {
              "$ref": "#/$defs/failure_envelope"
            },
            {
              "type": "null"
            }
          ]
        },
        "outcome": {
          "enum": [
            "success",
            "partial_success",
            "legal_stop",
            "failed"
          ]
        },
        "protocol_id": {
          "$ref": "#/$defs/stable_id"
        },
        "stages": {
          "items": {
            "$ref": "#/$defs/stage"
          },
          "maxItems": 9,
          "minItems": 9,
          "type": "array"
        }
      },
      "required": [
        "protocol_id",
        "stages",
        "outcome",
        "failure_envelope",
        "downstream_started"
      ],
      "type": "object"
    },
    "safe_ref": {
      "maxLength": 256,
      "minLength": 3,
      "type": "string"
    },
    "source_record": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "checksum_state": {
                "const": "not_observed"
              }
            }
          },
          "then": {
            "properties": {
              "observed_checksum": {
                "const": "not_observed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "checksum_state": {
                "const": "observed"
              }
            }
          },
          "then": {
            "properties": {
              "observed_checksum": {
                "$ref": "#/$defs/checksum"
              }
            }
          }
        }
      ],
      "properties": {
        "authority_class": {
          "enum": [
            "formal",
            "supplemental",
            "expert",
            "measurement"
          ]
        },
        "availability_state": {
          "enum": [
            "observed",
            "not_observed",
            "missing",
            "unreadable",
            "not_applicable"
          ]
        },
        "checksum_state": {
          "enum": [
            "observed",
            "not_observed"
          ]
        },
        "freshness_state": {
          "enum": [
            "fresh",
            "stale",
            "not_observed",
            "not_applicable"
          ]
        },
        "observed_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/timestamp"
            },
            {
              "const": "not_observed"
            }
          ]
        },
        "observed_checksum": {
          "oneOf": [
            {
              "$ref": "#/$defs/checksum"
            },
            {
              "const": "not_observed"
            }
          ]
        },
        "requirement_class": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "safe_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "source_id": {
          "$ref": "#/$defs/stable_id"
        }
      },
      "required": [
        "source_id",
        "safe_ref",
        "authority_class",
        "requirement_class",
        "availability_state",
        "freshness_state",
        "checksum_state",
        "observed_checksum",
        "observed_at"
      ],
      "type": "object"
    },
    "stable_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$",
      "type": "string"
    },
    "stage": {
      "additionalProperties": false,
      "properties": {
        "invoked": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        },
        "stage_id": {
          "enum": [
            "accepted_context_binding",
            "source_inventory_integrity",
            "evidence_interpretation_classification",
            "admission_grounding_evaluation",
            "conflict_unknown_limitation_recording",
            "independent_admission_review",
            "a02_acceptance",
            "archive_lineage",
            "automated_external_verification"
          ]
        },
        "status": {
          "enum": [
            "completed",
            "skipped",
            "disabled",
            "not_attempted",
            "legal_stop",
            "failed"
          ]
        }
      },
      "required": [
        "stage_id",
        "status",
        "invoked",
        "reason"
      ],
      "type": "object"
    },
    "support_link": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "$ref": "#/$defs/claim_id"
        },
        "evidence_item_id": {
          "$ref": "#/$defs/evidence_item_id"
        },
        "relation": {
          "enum": [
            "supporting",
            "contradicting",
            "limiting"
          ]
        },
        "support_link_id": {
          "$ref": "#/$defs/support_link_id"
        }
      },
      "required": [
        "support_link_id",
        "evidence_item_id",
        "claim_id",
        "relation"
      ],
      "type": "object"
    },
    "support_link_id": {
      "maxLength": 160,
      "minLength": 3,
      "pattern": "^support-link-[A-Za-z0-9._-]+$",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "type": "string"
    }
  },
  "$id": "https://collaborationos.local/schemas/COS_Evidence_Record_v0.1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_lifecycle": {
            "const": "accepted"
          }
        }
      },
      "then": {
        "properties": {
          "acceptance_event": {
            "$ref": "#/$defs/acceptance_event"
          }
        }
      }
    }
  ],
  "properties": {
    "acceptance_event": {
      "oneOf": [
        {
          "$ref": "#/$defs/acceptance_event"
        },
        {
          "type": "null"
        }
      ]
    },
    "admission_events": {
      "items": {
        "$ref": "#/$defs/admission_event"
      },
      "minItems": 1,
      "type": "array"
    },
    "artifact_id": {
      "$ref": "#/$defs/artifact_id"
    },
    "artifact_lifecycle": {
      "enum": [
        "draft",
        "under_review",
        "accepted",
        "rejected",
        "superseded"
      ]
    },
    "artifact_type": {
      "const": "COS-A02"
    },
    "context_ref": {
      "$ref": "#/$defs/artifact_ref"
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "current_admission": {
      "items": {
        "$ref": "#/$defs/current_admission"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "evidence_items": {
      "items": {
        "$ref": "#/$defs/evidence_item"
      },
      "minItems": 1,
      "type": "array"
    },
    "interpretations": {
      "items": {
        "$ref": "#/$defs/interpretation"
      },
      "type": "array"
    },
    "limitations": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "protocol_run": {
      "$ref": "#/$defs/protocol_run"
    },
    "reviewer_binding": {
      "$ref": "#/$defs/actor_binding"
    },
    "schema_version": {
      "const": "0.1"
    },
    "source_register": {
      "items": {
        "$ref": "#/$defs/source_record"
      },
      "minItems": 1,
      "type": "array"
    },
    "submitter_actor_id": {
      "$ref": "#/$defs/stable_id"
    },
    "support_links": {
      "items": {
        "$ref": "#/$defs/support_link"
      },
      "minItems": 1,
      "type": "array"
    },
    "unknowns": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "created_at",
    "artifact_lifecycle",
    "context_ref",
    "submitter_actor_id",
    "reviewer_binding",
    "source_register",
    "evidence_items",
    "interpretations",
    "support_links",
    "admission_events",
    "current_admission",
    "limitations",
    "unknowns",
    "protocol_run",
    "acceptance_event"
  ],
  "title": "COS A02 Evidence Record v0.1",
  "type": "object"
}
